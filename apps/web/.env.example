# Quick Qualify origins are resolved per client by the trusted portal API.
# Never expose a qualifier backend origin through a VITE_ environment variable.

# Local development uses Vite's /portal-api proxy to http://localhost:3001,
# and Vercel rewrites the same path to the deployed portal API.
# PORTAL_API_PROXY_TARGET=http://localhost:3001

# Vercel preview uses the same-origin /portal-api rewrite in vercel.json.
# Configure this as a Preview build variable in the web Vercel project.
# VITE_PORTAL_API_BASE_URL=/portal-api
